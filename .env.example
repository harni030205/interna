# Interna Environment Configuration Template
# Configure real secrets via the Secrets panel in Google AI Studio.
# Never commit real API keys or tokens to version control.

# GEMINI_API_KEY: Required for online Interna AI conversations, translations, and linguistic explanations.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ADMIN_PROVISION_TOKEN: Strong, one-time secret token used strictly for initial administrator
# provisioning of harinirinaianjara@gmail.com. Checked on the backend/security layer, prevented from
# reuse after provisioning succeeds, and never exposed to ordinary users.
ADMIN_PROVISION_TOKEN=CONFIGURE_IN_SECRETS_PANEL

# INTERNA_BACKEND_URL: Set to your deployed HTTPS backend URL (https://...) for server-side
# authorization, payment verification, administrator management, and proxied AI requests.
# Keep DIRECT_GEMINI_MODE strictly for Gemini AI calls when no external HTTPS backend is deployed yet.
INTERNA_BACKEND_URL=DIRECT_GEMINI_MODE
